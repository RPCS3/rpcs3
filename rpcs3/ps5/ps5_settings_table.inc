// Generated by settings_table.py from rpcs3qt/settings_dialog.cpp, settings_dialog.ui
// and tooltips.h: the desktop dialog's settings, by tab. Do not edit; run it again
{"CPU", emu_settings_type::XFloatAccuracy, "SPU XFloat Accuracy", "Control accuracy to SPU float vectors processing.\nFixes bugs in various games at the cost of performance.\nThis setting is only applied when SPU Decoder is set to Dynamic or LLVM."},
{"CPU", emu_settings_type::SPUBlockSize, "SPU Block Size", "This option controls the SPU analyser, particularly the size of compiled units. The Mega and Giga modes may improve performance by tying smaller units together, decreasing the number of compiled units but increasing their size.\nUse the Safe mode for maximum compatibility."},
{"CPU", emu_settings_type::ThreadSchedulerMode, "Thread Scheduler", "Control how RPCS3 utilizes the threads of your system.\nEach option heavily depends on the game and on your CPU. It's recommended to try each option to find out which performs the best.\nChanging the thread scheduler is not supported on CPUs with less than 12 threads."},
{"CPU", emu_settings_type::PreferredSPUThreads, "Preferred SPU Threads", "Some SPU stages are sensitive to race conditions and allowing a limited number at a time helps alleviate performance stalls.\nSetting this to a smaller value might improve performance and reduce stuttering in some games.\nLeave this on auto if performance is negatively affected when setting a small value."},
{"CPU", emu_settings_type::SPUOwnCore, "Own core for the busy SPU", "Runs the kernel of a SPURS instance of one SPU alone on one of the console's CPU cores, and keeps every other emulator thread off that core. In GTA IV it is the busiest thread of all in busy streets (its sound and more), and the game waits for it. Off, the console's system places every thread, and two busy ones can share a core. Takes effect when the game starts."},
{"CPU", emu_settings_type::SPUCollisionAccuracy, "Collision accuracy (GTA IV)", "How GTA IV's collision code on the SPUs is compiled. Learnt: the first five minutes or so of play watch which parts of it meet the numbers that need the slow, accurate maths, and from the next start of the game only those parts use it, so the SPUs that run collision work less. Accurate: all of it, as before (if cars or Niko fall through the ground with Learnt). Fast: none of it, a test: cars and Niko fall through the ground. Takes effect when the game starts."},
{"CPU", emu_settings_type::PPUDecoder, "PPU decoder", "Recompiles and caches the game's PPU code using the LLVM Recompiler once before running it for the first time.\nThis is by far the fastest option and should always be used.\nShould you face compatibility issues, fall back to one of the Interpreters and retry.\nIf unsure, use this option."},
{"CPU", emu_settings_type::SPUDecoder, "SPU decoder", "Recompiles and caches the game's SPU code using the LLVM Recompiler before running which adds extra start-up time.\nThis is the fastest option with very good compatibility.\nIf you experience issues, use the ASMJIT Recompiler."},
{"CPU", emu_settings_type::MaxPreemptCount, "Max Power Saving CPU-preemptions", "Reduces CPU usage and power consumption, improving battery life on mobile devices. (0 means disabled)\nHigher values cause a more pronounced effect, but may cause audio or performance issues. A value of 50 or less is recommended.\nThis option forces an FPS limit because it's active when framerate is stable.\nThe lighter the game is on the hardware, the more power is saved by it. (until the preemption count barrier is reached)"},
{"GPU", emu_settings_type::Resolution, "Default Resolution", "This setting will be ignored if the Resolution Scale is set to anything other than 100%!\nLeave this on 1280x720. Every PS3 game is compatible with this resolution.\nOnly use 1920x1080 if the game supports it.\nRarely due to emulation bugs some games will only render at low resolutions like 480p."},
{"GPU", emu_settings_type::AspectRatio, "Aspect Ratio", "Leave this on 16:9 unless you have a 4:3 monitor."},
{"GPU", emu_settings_type::FrameLimit, "Framelimit", "Off is the fastest option.\nUsing the frame limiter will add extra overhead and slow down the game. However, some games will crash if the framerate is too high.\nPS3 native should only be used if Auto is not working correctly as it can introduce frame-pacing issues.\nInfinite adds a positive feedback loop which adds another vblank signal per frame allowing more games to be fps limitless.\nExperienced users with need of other frame limits should use the setting \"Second Frame Limit\" in the configuration file."},
{"GPU", emu_settings_type::VSync, "Vsync", "Enables vertical synchronization to eliminate tearing.\nAdaptive Mode - Prefers keeping up performance. It may skip frames or even tear to avoid reducing the game's framerate.\nFull Mode - No tearing allowed even if performance is reduced. This mode will by default limit your framerate to the display's refresh rate unless overriden in the driver control panel."},
{"GPU", emu_settings_type::MSAA, "Anti-Aliasing (MSAA)", "Emulate PS3 multisampling layout.\nCan fix some otherwise difficult to solve graphics glitches.\nLow to moderate performance hit depending on your GPU hardware."},
{"GPU", emu_settings_type::AnisotropicFilterOverride, "Anisotropic Filter", "Higher values increase sharpness of textures on sloped surfaces at the cost of GPU resources.\nModern GPUs can handle this setting just fine, even at 16x.\nKeep this on Automatic if you want to use the original setting used by a real PS3."},
{"GPU", emu_settings_type::ShaderPrecisionQuality, "Shader Quality", "Controls the precision level of generated shaders. Low precision generates much faster code depending on the hardware, but can sometimes generate minor visual glitches or flicker."},
{"GPU", emu_settings_type::RelaxedZCULL, "Relaxed ZCULL sync", "Changes ZCULL report synchronization behaviour. Experiment to find the best option for your game. Approximate mode is recommended for most games.\n· Precise is the most accurate to PS3 behaviour. Required for accurate visuals in some titles such as Demon's Souls and The Darkness.\n· Approximate is a much faster way to generate occlusion data which may not always match what the PS3 would generate. Works well with most PS3 games.\n· Relaxed changes the synchronization method completely and can greatly improve performance in some games or completely break others."},
{"GPU", emu_settings_type::PreciseZCULL, "Precise ZCULL stats", "Changes ZCULL report synchronization behaviour. Experiment to find the best option for your game. Approximate mode is recommended for most games.\n· Precise is the most accurate to PS3 behaviour. Required for accurate visuals in some titles such as Demon's Souls and The Darkness.\n· Approximate is a much faster way to generate occlusion data which may not always match what the PS3 would generate. Works well with most PS3 games.\n· Relaxed changes the synchronization method completely and can greatly improve performance in some games or completely break others."},
{"GPU", emu_settings_type::OutputScalingMode, "Output Scaling", "Final image filtering. Nearest applies no filtering, Bilinear smooths the image, and FidelityFX Super Resolution enhances upscaled images.\nIf the game is rendering at an internal resolution lower than your window resolution, FidelityFX will handle the upscale.\nFidelityFX can cause visual artifacts.\nFidelityFX does not work with stereo 3D output for now."},
{"GPU", emu_settings_type::FrameGeneration, "Frame generation", "Shows frames made between the game's own when the game runs slower than the display's 60 frames a second: motion looks smoother. The game itself runs no faster, each of its frames reaches the screen a refresh (17 ms) later for each frame made before it, and fast motion, text and the HUD can shimmer or smear."},
{"GPU", emu_settings_type::FrameGenerationFrames, "Frames made between", "The most frames made between two of the game's. They go up one a refresh, only as many as the time between the game's frames has room for beside what the screen still has waiting, and a frame that would have to wait for the screen is dropped, so the game is not held back. At 24 fps, 1 shows about 48 frames a second and Auto (up to 3) nearly 60. Each frame made puts the game's own a refresh (17 ms) later."},
{"GPU", emu_settings_type::FrameGenerationQuality, "Frame generation quality", "How hard frame generation looks for motion: Fast follows it in a copy of the picture 480 pixels across, Balanced 640, Quality 960. Each follows moves of up to about a fifth of the screen between two of the game's frames; higher follows the edges of moving things more closely and takes more of the GPU's time."},
{"GPU", emu_settings_type::FrameGenerationStepAside, "Frame generation steps aside", "When frame generation shows the game's own frames instead of making frames between them. Quick moves: when the camera moves more than about 6% of the screen between two of the game's frames (a quick turn), where frames made between break apart. Most moves: from about 3%, fewer odd frames while moving but less smoothing. Never: frames are always made."},
{"GPU", emu_settings_type::FrameGenerationMethod, "Frame generation method", "Which frame generation makes the frames between. Built-in: the title's own. Lossless Scaling: the Lossless Scaling app's, from your own copy of its Lossless.dll (Steam), put in the title's rpcs3 folder: /data/homebrew/PPSA99200/rpcs3/Lossless.dll. With it, the built-in one still keeps the HUD that stands still sharp and steps aside in quick camera moves, so the quality and steps-aside settings apply to both, as does Frames made between. Without the file, or if it cannot run, the built-in one carries on."},
{"GPU", emu_settings_type::StereoRenderMode, "3D", "Sets the 3D stereo rendering mode (only available in custom configurations with a default resolution of 720p).\nAnaglyph uses different colors for each eye, which can then be filtered with certain glasses.\nSide-by-Side is more commonly supported by VR viewer apps.\nOver-Under is closer to the native stereo output, but less commonly supported."},
{"GPU", emu_settings_type::StereoRenderEnabled, "Enable 3D Support", ""},
{"GPU", emu_settings_type::ScreenSize, "Screen Size (Inch)", ""},
{"GPU", emu_settings_type::WriteColorBuffers, "Write Color Buffers", "Enable this option if you get missing graphics or broken lighting ingame.\nMight degrade performance and introduce stuttering in some cases.\nRequired for Demon's Souls."},
{"GPU", emu_settings_type::StretchToDisplayArea, "Stretch To Display Area", "Overrides the aspect ratio and stretches the image to the full display area."},
{"GPU", emu_settings_type::MultithreadedRSX, "Multithreaded RSX", "Offloads some RSX operations to a secondary thread.\nImproves performance for high-core processors.\nMay cause slowdown in weaker CPUs due to the extra worker thread load."},
{"GPU", emu_settings_type::StrictRenderingMode, "Strict Rendering Mode", "Enforces strict compliance to the API specification.\nMight result in degraded performance in some games.\nCan resolve rare cases of missing graphics and flickering.\nIf unsure, don't use this option."},
{"GPU", emu_settings_type::VulkanAsyncTextureUploads, "Asynchronous Texture Streaming", "Stream textures to GPU in parallel with 3D rendering using asynchronous compute.\nCan improve performance on more powerful GPUs that have spare headroom.\nOnly works with Vulkan renderer and greatly benefits from having MTRSX enabled if you have a capable CPU."},
{"GPU", emu_settings_type::ShaderMode, "Shader mode", "This is the recommended option.\nIf a shader is not found in the cache, nothing will be rendered for this shader until it has compiled.\nYou may experience graphics pop-in."},
{"GPU", emu_settings_type::ResolutionScale, "Resolution Scale", "Scales the game's resolution by the given percentage.\nThe base resolution is always 1280x720.\nSet this value to 100% if you want to use the normal Resolution options.\nValues below 100% will usually not improve performance."},
{"GPU", emu_settings_type::MinimumScalableDimension, "Resolution Scale Threshold", "Only framebuffers greater than this size will be upscaled.\nIncreasing this value might fix problems with missing graphics when upscaling, especially when Write Color Buffers is enabled.\nIf unsure, don't change this option."},
{"GPU", emu_settings_type::FsrSharpeningStrength, "FidelityFX CAS sharpening strength", "Control the sharpening strength applied by FidelityFX Super Resolution. Higher values will give sharper output but may introduce artifacts."},
{"Audio", emu_settings_type::AudioChannelLayout, "Audio Output Format", "Determines the sound format of RPCS3.\nUse 'Auto' to let RPCS3 decide the best format based on the audio device and the emulated audio format."},
{"Audio", emu_settings_type::AudioFormat, "Audio Format", "Determines the sound format of the emulation.\nConfigure this setting if you want to switch between stereo and surround sound.\nChanging these values requires a restart of the game.\nThe manual setting will use your selected formats while the automatic setting will let the game choose from all available formats."},
{"Audio", emu_settings_type::AudioProvider, "Audio Provider", "Controls which PS3 audio API is used.\nGames use CellAudio, while VSH requires RSXAudio."},
{"Audio", emu_settings_type::AudioAvport, "RSXAudio Avport", "Controls which avport is used to sample audio data from."},
{"Audio", emu_settings_type::ConvertTo16Bit, "Convert to 16-bit", "Uses 16-bit audio samples instead of default 32-bit floating point.\nUse with buggy audio drivers if you have no sound or completely broken sound."},
{"Audio", emu_settings_type::EnableBuffering, "Enable Buffering", "Enables audio buffering, which reduces crackle/stutter but increases audio latency."},
{"Audio", emu_settings_type::EnableTimeStretching, "Enable Time Stretching", "Enables time stretching - requires buffering to be enabled.\nReduces crackle/stutter further, but may cause a very noticeable reduction in audio quality on slower CPUs."},
{"Audio", emu_settings_type::MasterVolume, "Master volume", "Controls the overall volume of the emulation.\nValues above 100% might reduce the audio quality."},
{"Audio", emu_settings_type::AudioBufferDuration, "Audio Buffer Duration", "Target buffer duration in milliseconds.\nHigher values make the buffering algorithm's job easier, but may introduce noticeable audio latency."},
{"Audio", emu_settings_type::TimeStretchingThreshold, "Time Stretching Threshold", "Buffer fill level (in percentage) below which time stretching will start."},
{"Audio", emu_settings_type::DisableSamplingSkip, "Disable sampling skip", "When a game is late with its sound, the emulator waits for it a little (about 11 ms) before skipping that bit of the sound. On, it never waits: the sound keeps strict time, and every late moment is skipped, heard as stutter. GTA IV on the console skipped 8 to 17 bits every 10 s with it on, 0 to 3 with it off. Some games that slow down waiting for their sound run better with it on."},
{"Audio", emu_settings_type::LateAudioWait, "Wait for late game sound", "How much longer than the emulator's own wait (about 11 ms) to wait for a game that is late with its sound, before skipping that bit of it (heard as a click or stutter). The sound already buffered plays on meanwhile, so a wait shorter than the audio buffer should not be heard. Off is RPCS3's own behaviour. Has no effect while Disable sampling skip is on."},
{"Audio", emu_settings_type::MenuSoundVolume, "Menu sounds", "How loud the menus' sounds are: moving, choosing, going back, messages and trophies, in the library, the pause menu and RPCS3's own dialogs. Off for none. To use sounds of your own, put WAV files named snd_cursor, snd_decide, snd_cancel, snd_system_ok, snd_system_ng, snd_oskenter, snd_oskcancel and snd_trophy (.wav) in the title's rpcs3/sounds folder over FTP; any you leave out keep the title's own."},
{"I/O", emu_settings_type::PadHandlerMode, "Pad Handler Mode", "Single-threaded: All pad handlers run on the same thread sequentially.\nMulti-threaded: Each pad handler has its own thread.\nOnly use multi-threaded if you can spare the extra threads."},
{"I/O", emu_settings_type::PadConnection, "Keep Pads Connected", "Shows all configured pads as always connected ingame even if they are physically disconnected."},
{"System", emu_settings_type::Language, "Console Language", "Some games may fail to boot if the system language is not available in the game itself.\nOther games will switch language automatically to what is selected here.\nIt is recommended leaving this on a language supported by the game."},
{"System", emu_settings_type::LicenseArea, "Console Region", "The console region defines the license area of the PS3.\nDepending on the license area, some games may not work."},
{"System", emu_settings_type::KeyboardType, "Keyboard Type", "Sets the used keyboard layout.\nCurrently only US, Japanese and German layouts are fully supported at this moment."},
{"System", emu_settings_type::DateFormat, "Date Format", "Select the PS3's date format."},
{"System", emu_settings_type::TimeFormat, "Time Format", "Select the PS3's time format."},
{"System", emu_settings_type::EmptyHdd0Tmp, "Empty /dev_hdd0/tmp/", "Required for some Homebrew or Game Mods.\nIf unsure, do not use this option"},
{"System", emu_settings_type::LimitCacheSize, "Clear cache automatically", "Automatically removes older files from disk cache on boot if it grows larger than the specified value.\nGames can use the cache folder to temporarily store data outside of system memory. It is not used for long-term storage.\n\nThis setting is only available in the global configuration."},
{"System", emu_settings_type::MaximumCacheSize, "Maximum cache size (MB)", ""},
{"System", emu_settings_type::EnterButtonAssignment, "Enter button assignment", "The button used for enter/accept/confirm in system dialogs.\nChange this to use the Circle button instead, which is the default configuration on Japanese systems and in many Japanese games.\nIn these cases having the cross button assigned can often lead to confusion."},
{"Network", emu_settings_type::EnableUpnp, "Enable UPNP", "Enable UPNP.\nThis will automatically forward ports bound on 0.0.0.0 if your router has UPNP enabled."},
{"Network", emu_settings_type::DeriveMacFromPsid, "Derive ethernet address from PSID", "Derive the MAC address from the PSID."},
{"Network", emu_settings_type::EnableClans, "Enable Clans", "Enable connection to the Clans server.\nOnly affects games supporting the Clans feature."},
{"Network", emu_settings_type::InternetStatus, "Network Status", "If set to Connected, RPCS3 will allow programs to use your internet connection."},
{"Network", emu_settings_type::PSNStatus, "PSN Status", "If set to RPCN, RPCS3 will use the RPCN server as PSN connection if the game is supported.\nIf set to Simulated, RPCS3 will try to fake the PSN connection, but any actual attempt at using the PSN functionality may result in errors or crashes.\nSimulated is only available in custom configurations."},
{"Advanced", emu_settings_type::SPULoopDetection, "Enable SPU Loop Detection", "Try to detect loop conditions in SPU kernels and use them as scheduling hints.\nImproves performance and reduces CPU usage.\nMay cause severe audio stuttering in rare cases."},
{"Advanced", emu_settings_type::PPUReservationPriorityOverSPUs, "PPU Reservation Priority", "Give PPUs an execution advantage when the SPUs are using reservations.\nThis setting is recommended only for a few game for improving performance.\nDO NOT use it without being advised to due to potential performance degradation."},
{"Advanced", emu_settings_type::AccurateSpuReservations, "Accurate SPU Reservations", "Accurately emulates SPU reservations.\nDisabling it can greatly improve performance.\nStability may be compromised in some games but not in others, disable only if advised."},
{"Advanced", emu_settings_type::DisableBlitEngineScaling, "Disable Blit Engine Upscaling", "Disable upscaling on the RSX image scaling and rotation engine (NV3089) outputs.\nThis may fix some crashes and visual bugs in some games (e.g GT5, DJH2) that happen only when upscaling is being used.\nHowever, some games will appear as if they're running at 100% resolution regardless of the upscaling ratio used if this option is enabled."},
{"Advanced", emu_settings_type::DebugConsoleMode, "Debug Console Mode", "Increases the amount of usable system memory to match a DECR console and more.\nCauses some software to behave differently than on retail hardware."},
{"Advanced", emu_settings_type::AccurateRSXAccess, "Accurate RSX Reservation Access", "Forces RSX pauses on SPU MFC_GETLLAR and SPU MFC_PUTLLUC operations."},
{"Advanced", emu_settings_type::AccurateSpuDMA, "Accurate SPU DMA", "Accurately processes SPU DMA operations."},
{"Advanced", emu_settings_type::LLVMPrecompilation, "PPU/SPU LLVM Precompilation", "Searches the game's directory and precompiles extra PPU and SPU modules during boot.\nIf disabled, these modules will only be compiled when needed. Depending on the game, this might interrupt the gameplay unexpectedly and possibly frequently.\nOnly disable this if you want to get ingame more quickly."},
{"Advanced", emu_settings_type::SuspendEmulationSavestateMode, "Anti-Cheat Savestates Mode", "When this mode is on, emulation exits when saving and the savestate file is concealed after its load, preventing reuse by RPCS3.\nThis mode is like hibernation of emulation: if you don't want to be able to cheat using savestates when playing the game, consider using this mode.\nDo note that the savestate file is not gone completely, just ignored by RPCS3. You can manually relaunch it if needed."},
{"Advanced", emu_settings_type::CompatibleEmulationSavestateMode, "SPU Compatible Savestates Mode", "When this mode is on, SPU emulation prioritizes savestate compatibility, however, it may reduce performance slightly.\nWhen this mode is off, some games may not allow making a savestate and show an SPU pause error in the log."},
{"Advanced", emu_settings_type::SilenceAllLogs, "Silence All Logs", "Stop writing any logs after game startup. Don't use unless you believe it's necessary."},
{"Advanced", emu_settings_type::ReadColorBuffers, "Read Color Buffers", "Initializes render target memory using vm memory."},
{"Advanced", emu_settings_type::ReadDepthBuffer, "Read Depth Buffer", "Initializes render target memory using vm memory."},
{"Advanced", emu_settings_type::WriteDepthBuffer, "Write Depth Buffer", "Writes depth buffer values to vm memory."},
{"Advanced", emu_settings_type::HandleRSXTiledMemory, "Handle RSX Memory Tiling", "Obey RSX memory tiling configuration when writing GPU data to vm memory.\nThis can fix graphics corruption observed when Read Color or Read Depth options are enabled."},
{"Advanced", emu_settings_type::DisableSpinOptimization, "Disable SPU GETLLAR Spin Optimization", "Disable SPU GETLLAR spin optimization.\nThis can cause severe performance degradation and stuttering in many games.\nThis option is only needed for a select number of games."},
{"Advanced", emu_settings_type::EmulateHddSpeed, "Emulate HDD Read Speed", "May fix games that break when data loads faster than on a PS3 at the cost of longer loading times.\nIf unsure, do not use this option."},
{"Advanced", emu_settings_type::EmulateBdvdSpeed, "Emulate BD-ROM Read Speed", "Approximates the read speed of the PS3 Blu-ray drive for games run from disc.\nMay fix games that break when disc data loads faster than on a PS3, such as videos with corrupted blocks, at the cost of longer loading times.\nIf unsure, do not use this option."},
{"Advanced", emu_settings_type::MaxSPURSThreads, "Maximum Number of SPURS Threads", "Limits the maximum number of SPURS threads in each thread group.\nMay improve performance in some cases, especially on systems with limited number of hardware threads.\nLimiting the number of threads is likely to cause crashes; it's recommended to keep this at the default value."},
{"Advanced", emu_settings_type::SleepTimersAccuracy, "Sleep Timers Accuracy", "Changes the sleep period accuracy.\n'As Host' uses default accuracy of the underlying operating system, while 'All Timers' attempts to improve it.\n'Usleep Only' limits the adjustments to usleep syscall only.\nCan affect performance in unexpected ways."},
{"Advanced", emu_settings_type::FIFOAccuracy, "RSX FIFO Accuracy", "\"Fast\" is the least accurate setting, RSX does not emulate atomic FIFO buffer.\n\"Atomic\" benefits stability greatly in many games with little performance penalty.\n\"Atomic & Ordered\" is the most accurate but it is the slowest and without much stability benefit in games."},
{"Advanced", emu_settings_type::DriverWakeUpDelay, "Driver Wake-Up Delay", "Controls how much time it takes for RSX to start processing after waking up by the Cell processor.\nIncreasing wakeup delay improves stability, but very high values can lower RSX/GPU performance.\nIt is recommend to adjust this at 20µs to 40µs increments until the best value for optimal stability is reached."},
{"Advanced", emu_settings_type::VBlankRate, "VBlank Frequency", "Adjusts the frequency of vertical blanking signals that the emulator sends.\nAffects timing of events which rely on these signals."},
{"Advanced", emu_settings_type::ClocksScale, "Clocks Scale", "Changes the scale of emulated system time.\nAffects software which uses system time to calculate things such as dynamic timesteps."},
{"Advanced", emu_settings_type::AllowHostGPULabels, "Allow Host GPU Labels (Experimental)", "Allows the host GPU to synchronize with CELL directly. This incurs a performance penalty, but exposes the true state of GPU objects to the guest CPU. Can help eliminate visual noise and glitching at the cost of performance. Use with caution."},
{"Advanced", emu_settings_type::DisableVertexCache, "Disable Vertex Cache", "Disables the vertex cache.\nMight resolve missing or flickering graphics output.\nMay degrade performance."},
{"Advanced", emu_settings_type::EmulateDepthCompare, "Emulate Special Depth Comparison", "Emulate depth comparison operations where desktop hardware behavior differs from PS3, usually EQUAL comparison modes.\nFixes excessive shadow flickering and Z-fighting in some games.\nThis is most obvious in some games where the Z prepass depth format is different from the rasterization depth format, a scenario that will never work out correctly on compliant desktop hardware."},
{"Advanced", emu_settings_type::ForceHwMSAAResolve, "Force Hardware MSAA Resolve", "Forces MSAA to use the host GPU's resolve capabilities for all sampling operations.\nThis option incurs a performance penalty as well as the risk of visual artifacts but can yield crisper visuals when MSAA is enabled."},
{"Advanced", emu_settings_type::UseReBAR, "Use Re-BAR memory for GPU uploads", "When enabled, Vulkan will try to use PCI-e resizable bar address space for GPU uploads of timing-sensitive data.\nThis yields a massive performance win on NVIDIA cards when the base framerate is low.\nFor games with very high framerates, this option can result in worse performance for all GPU vendors."},
{"Emulator", emu_settings_type::MaxLLVMThreads, "Max LLVM Compile Threads", "Limits the maximum number of threads used for the initial PPU and SPU module compilation.\nLower this in order to increase performance of other open applications.\nThe default uses all available threads."},
{"Emulator", emu_settings_type::ShaderCompilerNumThreads, "Max Shader Compile Threads", "Number of threads to use for the shader compiler backend.\nOnly has an impact when shader mode is set to one of the asynchronous modes."},
{"Emulator", emu_settings_type::PerfOverlayDetailLevel, "Performance overlay detail level", "Controls the amount of information displayed on the performance overlay."},
{"Emulator", emu_settings_type::PerfOverlayPosition, "Performance overlay position", "Sets the on-screen position (quadrant) of the performance overlay."},
{"Emulator", emu_settings_type::ShowTrophyPopups, "Show trophy popups", "Show trophy pop-ups when a trophy is unlocked."},
{"Emulator", emu_settings_type::PlayMusicDuringBoot, "Play music during boot sequence", "Play music during boot sequence if available."},
{"Emulator", emu_settings_type::ShowShaderCompilationHint, "Show shader compilation hint", "Shows 'Compiling shaders' hint using the native overlay."},
{"Emulator", emu_settings_type::ShowPPUCompilationHint, "Show PPU compilation hint", "Shows 'Compiling PPU modules' hint using the native overlay."},
{"Emulator", emu_settings_type::ShowAutosaveAutoloadHint, "Show autosave/autoload hint", "Shows autosave/autoload hint using the native overlay."},
{"Emulator", emu_settings_type::ShowPressureIntensityToggleHint, "Show pressure intensity toggle hint", "Shows pressure intensity toggle hint using the native overlay."},
{"Emulator", emu_settings_type::ShowAnalogLimiterToggleHint, "Show analog limiter toggle hint", "Shows analog limiter toggle hint using the native overlay."},
{"Emulator", emu_settings_type::ShowFatalErrorHints, "Show fatal error hints", "Shows fatal error hints using the native overlay."},
{"Emulator", emu_settings_type::PauseDuringHomeMenu, "Pause emulation during home menu", "When enabled, opening the home menu will also pause emulation.\nWhile most games pause themselves while the home menu is shown, some do not.\nIn that case it can be helpful to pause the emulation whenever the home menu is open."},
{"Emulator", emu_settings_type::StartSavestatePaused, "Pause emulation after loading savestates", "When this mode is on, savestates are loaded and paused on the first frame.\nThis allows players to prepare for gameplay without being thrown into the action immediately."},
{"Emulator", emu_settings_type::PerfOverlayCenterX, "Centre the performance overlay across", "Centers the performance overlay horizontally and overrides the horizontal margin."},
{"Emulator", emu_settings_type::PerfOverlayCenterY, "Centre the performance overlay down", "Centers the performance overlay vertically and overrides the vertical margin."},
{"Emulator", emu_settings_type::PerfOverlayFramerateGraphEnabled, "Show framerate graph", "Enables or disables the framerate graph."},
{"Emulator", emu_settings_type::PerfOverlayFrametimeGraphEnabled, "Show frametime graph", "Enables or disables the frametime graph."},
{"Emulator", emu_settings_type::PerfOverlayEnabled, "Enable performance overlay", "Enables or disables the performance overlay."},
{"Emulator", emu_settings_type::ShaderLoadBgEnabled, "Shader loading: allow a custom background", "Shows a background image during the native shader loading dialog/loading screen.\nBy default the used image will be /PS3_GAME/PIC1.PNG."},
{"Emulator", emu_settings_type::PerfOverlayUpdateInterval, "Performance overlay update interval", "Sets the time interval in which the performance overlay is being updated (measured in milliseconds).\nSetting this to 16 milliseconds will refresh the performance overlay at roughly 60Hz.\nThe performance overlay refresh rate does not affect the frame graph statistics and can only be as fast as the current game allows."},
{"Emulator", emu_settings_type::PerfOverlayFontSize, "Performance overlay font size", "Sets the font size of the performance overlay (measured in pixels)."},
{"Emulator", emu_settings_type::PerfOverlayOpacity, "Performance overlay opacity", "Sets the opacity of the performance overlay (measured in %)."},
{"Emulator", emu_settings_type::PerfOverlayFramerateDatapoints, "Framerate graph datapoints", "Sets the amount of datapoints used in the framerate graph."},
{"Emulator", emu_settings_type::PerfOverlayFrametimeDatapoints, "Frametime graph datapoints", "Sets the amount of datapoints used in the frametime graph."},
{"Emulator", emu_settings_type::ShaderLoadBgDarkening, "Shader loading: background darkening", "Changes the background image darkening effect strength of the native shader loading dialog.\nThis may be used to improve readability and/or aesthetics."},
{"Emulator", emu_settings_type::ShaderLoadBgBlur, "Shader loading: background blur", "Changes the background image blur effect strength of the native shader loading dialog.\nThis may be used to improve readability and/or aesthetics."},
{"Emulator", emu_settings_type::PerfOverlayMarginX, "Performance overlay margin across (%)", "Sets the horizontal distance to the screen border relative to the screen quadrant (measured in %)."},
{"Emulator", emu_settings_type::PerfOverlayMarginY, "Performance overlay margin down (%)", "Sets the vertical distance to the screen border relative to the screen quadrant (measured in %)."},
{"Debug", emu_settings_type::TextureLodBias, "LOD Bias Offset", "Changes Texture sampling accuracy. (Small changes have a big effect.)\nAvoid using values outside the range of -12 to +12 if you're unsure.\n-3 to +3 is plenty for most usecases"},
{"Debug", emu_settings_type::SPUProfiler, "SPU Profiler", "When enabled, SPU performance is measured at runtime.\nEnable only at a developer's request because when enabled it reduces performance a bit by itself."},
{"Debug", emu_settings_type::SetDAZandFTZ, "PPU Set DAZ and FTZ", "Sets special MXCSR flags to debug errors in SSE operations.\nAccelerates PPU performance at the cost of accuracy."},
{"Debug", emu_settings_type::DisableAsyncHostMM, "Disable Asynchronous Memory Manager", "Force host memory management calls to be inlined instead of handled asynchronously.\nThis can cause severe performance degradation and stuttering in some games.\nThis option is only needed by developers to debug problems with texture cache memory protection."},
{"Debug", emu_settings_type::DisableHWTexelRemapping, "Disable Hardware ColorSpace Remapping", "Disables use of hardware-native color-space remapping formats such as _sRGB and _SNORM suffixes.\nDisabling this option increases accuracy compared to PS3 but can also introduce some noise due to how the software emulation works."},
{"Debug", emu_settings_type::DisableHWBlending, "Disable Hardware Blending", "Force use of programmable blending for backends that support the feature.\nPurely a debugging option, you don't stand to gain anything by enabling this."},
{"Debug", emu_settings_type::ForceHighpZ, "Use High Precision Z-Buffer", "Only useful when debugging differences in GPU hardware.\nNot necessary for average users.\nIf unsure, don't use this option."},
{"Debug", emu_settings_type::DebugOverlay, "Debug Overlay", "Provides a graphical overlay of various debugging information.\nIf unsure, don't use this option."},
{"Debug", emu_settings_type::LogShaderPrograms, "Log Shader Programs", "Dump game shaders to file. Only useful to developers.\nIf unsure, don't use this option."},
{"Debug", emu_settings_type::DisableOcclusionQueries, "Disable ZCull Occlusion Queries", "Disables running occlusion queries. Minor to moderate performance boost.\nMight introduce issues with broken occlusion e.g missing geometry and extreme pop-in."},
{"Debug", emu_settings_type::ForceCPUBlitEmulation, "Force CPU Blit Emulation", "Forces emulation of all blit and image manipulation operations on the CPU.\nRequires 'Write Color Buffers' option to also be enabled in most cases to avoid missing graphics.\nSignificantly degrades performance but is more accurate in some cases.\nThis setting overrides the 'GPU texture scaling' option."},
{"Debug", emu_settings_type::DisableVulkanMemAllocator, "Disable Vulkan Memory Allocator", "Disables the custom Vulkan memory allocator and reverts to direct calls to VkAllocateMemory/VkFreeMemory."},
{"Debug", emu_settings_type::DisableFIFOReordering, "Disable FIFO Reordering", "Disables RSX FIFO optimizations completely. Draws are processed as they are received by the DMA puller."},
{"Debug", emu_settings_type::StrictTextureFlushing, "Strict Texture Flushing", "Forces texture flushing even in situations where it is not necessary/correct. Known to cause visual artifacts, but useful for debugging certain texture cache issues."},
{"Debug", emu_settings_type::GPUTextureScaling, "Force GPU Texture Scaling", "Force all texture transfer, scaling and conversion operations on the GPU.\nMay cause texture corruption in some cases."},
{"Debug", emu_settings_type::DisableOnDiskShaderCache, "Disable On-Disk Shader Cache", "Disables the loading and saving of shaders from and to the shader cache in the data directory."},
{"Debug", emu_settings_type::PPUDebug, "PPU Debug", "Creates PPU logs.\nOnly useful to developers.\nNever use this."},
{"Debug", emu_settings_type::SPUDebug, "SPU Debug", "Creates SPU logs.\nOnly useful to developers.\nNever use this."},
{"Debug", emu_settings_type::MFCDebug, "MFC Debug", "Creates MFC logs.\nOnly useful to developers.\nNever use this."},
{"Debug", emu_settings_type::AccuratePPUSAT, "Accurate PPU Saturation Bit", "Accurately set Saturation Bit values in PPU backends.\nIf unsure, do not modify this setting."},
{"Debug", emu_settings_type::AccuratePPUNJ, "Accurate PPU Non-Java Mode", "Respect Non-Java Mode Bit values for vector ops in PPU backends.\nIf unsure, do not modify this setting."},
{"Debug", emu_settings_type::AccuratePPUVNAN, "Accurate PPU Vector NaN Handling", "Accurately set NaN results in vector instructions in PPU backends.\nIf unsure, do not modify this setting."},
{"Debug", emu_settings_type::AccuratePPUFPCC, "Accurate PPU Float Condition Control", "Accurately set FPCC Bits in PPU backends.\nIf unsure, do not modify this setting."},
{"Debug", emu_settings_type::AccurateClineStores, "Accurate PPU/SPU Cache Line Stores", "Accurately processes PPU DCBZ instruction.\nIn addition, when combined with Accurate SPU DMA, SPU PUT cache line accesses will be processed atomically."},
{"Debug", emu_settings_type::HookStaticFuncs, "Hook static functions", "Allows to hook some functions like 'memcpy' replacing them with high-level implementations. May do nothing or break things. Experimental."},
{"Debug", emu_settings_type::PerformanceReport, "Enable performance report", "Measure certain events and print a chart after the emulator is stopped. Don't enable if not asked to."},
{"Debug", emu_settings_type::EnabledSPUEventsBusyLoop, "Enable SPU Events Busy Loop", "Enable SPU RdEventStat spin.\nThis increases CPU usage, this setting is beneficial for high-threaded CPUs (12+) with select number of games."},
{"Debug", emu_settings_type::IoDebugOverlay, "Debug Overlay For Pad Input", "Provides a graphical overlay with pad input values for player 1.\nThis is only shown if the debug overlay is disabled.\nIf unsure, don't use this option."},
{"Debug", emu_settings_type::FramebufferAliasingBias, "Framebuffer Aliasing Heuristic Bias", "Controls how RPCS3 resolves render targets where color and depth alias the same memory. Auto is recommended for most games.\n· Auto is the existing behavior, biased toward depth.\n· Prefer Color keeps the color binding when color-write is enabled and depth-write is not. Fixes missing geometry in some deferred renderers (e.g. Starhawk) at the cost of skipping depth test for that draw.\n· Prefer Depth is the same as Auto for now."},
{"Debug", emu_settings_type::AccuratePPU128Loop, "Accurate PPU 128 Reservations", "When enabled, PPU atomic operations will operate on entire cache line data, as opposed to a single 64bit block of memory when disabled.\nNumerical values control whether or not to enable the accurate version based on the atomic operation's length."},
{"Debug", emu_settings_type::NumPPUThreads, "PPU Thread Count", "Affects maximum amount of PPU threads running concurrently, the value of 1 has very low compatibility with games.\n2 is the default, if unsure do not modify this setting."},
{"Debug", emu_settings_type::VulkanAsyncSchedulerDriver, "Vulkan Queue Scheduler", "Determines how to schedule GPU async compute jobs when using asynchronous streaming.\nUse 'Safe' mode for more spec compliant behavior at the cost of some CPU overhead. This setting works with all devices.\nUse 'Fast' to use a faster but hacky version. This option is internally disabled for NVIDIA GPUs due to causing GPU hangs."},
