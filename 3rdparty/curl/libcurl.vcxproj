  <PropertyGroup Label="UserMacros">
    <CmakeReleaseCLI>call vsdevcmd.bat -arch=amd64
      cd "$(SolutionDir)build\tmp\$(ProjectName)-$(Configuration)-$(Platform)"
      if not defined CCACHE_LAUNCH_ARGS set CCACHE_LAUNCH_ARGS=
      cmake -G Ninja ^
        -DCMAKE_CXX_COMPILER="cl.exe" ^
        -DCMAKE_C_COMPILER="cl.exe" ^
        %25CCACHE_LAUNCH_ARGS%25 ^
        -DCMAKE_BUILD_TYPE="Release" ^
        -DCMAKE_INSTALL_PREFIX="./Release" ^
        -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded ^
        -DCMAKE_SYSTEM_VERSION=10.0 ^
        -DBUILD_SHARED_LIBS=OFF ^
        -DBUILD_CURL_EXE=OFF ^
        -DBUILD_TESTING=OFF ^
        -DCURL_USE_WOLFSSL=ON ^
        -DCURL_USE_IPV6=ON ^
        -DCURL_USE_SCHANNEL=OFF ^
        -DCURL_USE_OPENSSL=OFF ^
        -DCURL_USE_LIBPSL=OFF ^
        -DCURL_ZLIB=OFF ^
        -DCURL_USE_LIBSSH2=OFF ^
        -DCMAKE_C_FLAGS="/DWOLFSSL_ALT_CERT_CHAINS /DHAVE_SNI /DNO_MD4 /DWOLFSSL_USER_SETTINGS /DUSE_IPV6 /I\"$(SolutionDir)3rdparty\curl\extra\" /I\"$(SolutionDir)3rdparty\wolfssl\wolfssl\" /I\"$(SolutionDir)3rdparty\wolfssl\wolfssl\wolfssl\" /I\"$(SolutionDir)3rdparty\wolfssl\extra\win32\"" ^
        -DCMAKE_C_FLAGS_RELEASE="/O2 /Ob1 /GF /Gy /W0" ^
        -DWOLFSSL_INCLUDE_DIR="$(SolutionDir)3rdparty\wolfssl\wolfssl" ^
        -DWOLFSSL_LIBRARY="$(SolutionDir)build\lib\$(Configuration)-$(Platform)\wolfssl.lib" ^
        "$(SolutionDir)3rdparty\curl\curl"
    </CmakeReleaseCLI>
    <CmakeDebugCLI>call vsdevcmd.bat -arch=amd64
      cd "$(SolutionDir)build\tmp\$(ProjectName)-$(Configuration)-$(Platform)"
      if not defined CCACHE_LAUNCH_ARGS set CCACHE_LAUNCH_ARGS=
      cmake -G Ninja ^
        -DCMAKE_CXX_COMPILER="cl.exe" ^
        -DCMAKE_C_COMPILER="cl.exe" ^
        %25CCACHE_LAUNCH_ARGS%25 ^
        -DCMAKE_BUILD_TYPE="Debug" ^
        -DCMAKE_INSTALL_PREFIX="./Debug" ^
        -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDebug ^
        -DCMAKE_SYSTEM_VERSION=10.0 ^
        -DBUILD_SHARED_LIBS=OFF ^
        -DBUILD_CURL_EXE=OFF ^
        -DBUILD_TESTING=OFF ^
        -DCURL_USE_WOLFSSL=ON ^
        -DCURL_USE_IPV6=ON ^
        -DCURL_USE_SCHANNEL=OFF ^
        -DCURL_USE_OPENSSL=OFF ^
        -DCURL_USE_LIBPSL=OFF ^
        -DCURL_ZLIB=OFF ^
        -DCURL_USE_LIBSSH2=OFF ^
        -DCMAKE_C_FLAGS="/DWOLFSSL_ALT_CERT_CHAINS /DHAVE_SNI /DNO_MD4 /DWOLFSSL_USER_SETTINGS /DUSE_IPV6 /I\"$(SolutionDir)3rdparty\curl\extra\" /I\"$(SolutionDir)3rdparty\wolfssl\wolfssl\" /I\"$(SolutionDir)3rdparty\wolfssl\wolfssl\wolfssl\" /I\"$(SolutionDir)3rdparty\wolfssl\extra\win32\"" ^
        -DCMAKE_C_FLAGS_DEBUG="/Od /Ob0 /GF /Gy /W0" ^
        -DWOLFSSL_INCLUDE_DIR="$(SolutionDir)3rdparty\wolfssl\wolfssl" ^
        -DWOLFSSL_LIBRARY="$(SolutionDir)build\lib\$(Configuration)-$(Platform)\wolfssl.lib" ^
        "$(SolutionDir)3rdparty\curl\curl"
    </CmakeDebugCLI>
    <CmakeCopyCLI>
      echo Copying..
      copy "$(SolutionDir)build\tmp\$(ProjectName)-$(Configuration)-$(Platform)\lib\libcurl.lib" "$(SolutionDir)build\lib\$(Configuration)-$(Platform)"
    </CmakeCopyCLI>
    <CmakeCopyDebugCLI>
      echo Copying..
      copy "$(SolutionDir)build\tmp\$(ProjectName)-$(Configuration)-$(Platform)\lib\libcurl-d.lib" "$(SolutionDir)build\lib\$(Configuration)-$(Platform)"
    </CmakeCopyDebugCLI>
    <CmakeCleanCLI>
      echo Cleaning..
      del "$(SolutionDir)build\lib\$(Configuration)-$(Platform)\libcurl.lib"
      rmdir /s /q "$(SolutionDir)build\tmp\$(ProjectName)-$(Configuration)-$(Platform)"
    </CmakeCleanCLI>
    <CmakeCleanDebugCLI>
      echo Cleaning..
      del "$(SolutionDir)build\lib\$(Configuration)-$(Platform)\libcurl-d.lib"
      rmdir /s /q "$(SolutionDir)build\tmp\$(ProjectName)-$(Configuration)-$(Platform)"
    </CmakeCleanDebugCLI>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutDir>$(SolutionDir)build\lib\$(Configuration)-$(Platform)\</OutDir>
    <IntDir>$(SolutionDir)build\tmp\$(ProjectName)-$(Configuration)-$(Platform)\</IntDir>
    <NMakeBuildCommandLine>
      $(CmakeDebugCLI)
      ninja
      $(CmakeCopyDebugCLI)
    </NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>
      $(CmakeCleanDebugCLI)
      $(CmakeDebugCLI)
      ninja
